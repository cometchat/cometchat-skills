# Dependencies
node_modules/
*/node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Secrets / local env (NEVER commit real credentials — RULES.md §4)
.env
.env.local
cometchat-rn-app/src/chat/credentials.ts

# Session / release scratch reports (regenerated; never committed)
FINAL-REPORT.md
RUN-LEDGER.md
.env.*.local

# Transient verification artifacts (regenerated on each smoke run)
.playwright-mcp/
reviews/**/iter/**/emit/node_modules/
test-suite/.tmp/
test-suite/**/*.tmp

# Flutter Tier-2 sandbox: toolchain output is transient, but pubspec.lock IS tracked
# (it is the pin — same role as web-v7's package-lock.json). lib/__fences__ is written
# and deleted by typecheck-fences-dart.mjs on every run.
test-suite/typecheck/flutter-v6/.dart_tool/
test-suite/typecheck/flutter-v6/lib/__fences__/
.flutter-plugins-dependencies

# Editor / OS noise
.DS_Store
*.log
.idea/
.claude/scheduled_tasks.lock

# CLI-generated project config (belongs in the consumer's repo, not this pack)
.cometchat/
reviews/

# Local review / sample apps — scaffolded per families.json `appDir`, never committed
# (unreferenced by CI/scripts, not in files[], not synced to the public repo). May hold
# REAL dashboard credentials (e.g. src/environments/environment.ts).
cometchat-angular-app/
cometchat-react-app/
cometchat-rn-app/
# Gradle build state from the RN fixture — build output, never source.
test-suite/fixtures/bare-react-native/android/.gradle/
test-suite/harness/ios/**/cometchat-settings.json

# build artifacts — npm pack output, regenerated on demand
*.tgz

# review-run credentials — never commit
.env.review

# ── Internal / kept LOCAL only — never committed (see PUBLIC-REPO-EXCLUDE.md) ──
# Deploy templates — kept local for now (not shipped to npm, not in the public repo).
replit-template/
vercel-template/
# Internal scratch: dev screenshots + scratch capture notes (regenerated; never shipped).
/*.png
/cc-*.md
# harness credentials + build output (never commit)
test-suite/harness/flutter-v6/cometchat-settings.json
test-suite/harness/flutter-v6/.dart_tool/
test-suite/harness/flutter-v6/build/
test-suite/harness/flutter-v6/lib/emit/feature.dart

# iOS .swiftinterface files resolved by verify:swift-api:ios-v5:setup (SPM, macOS-only)
test-suite/typecheck/ios-v5/.interfaces/
